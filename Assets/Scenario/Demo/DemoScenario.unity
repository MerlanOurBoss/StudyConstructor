MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 695879695}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8be37030d6488f043b0616cad32a3822, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Scenario.Runtime::StudyConstructor.Scenario.ScenarioFlow
  sourceText: "// \u0423\u0447\u0435\u0431\u043D\u044B\u0439 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0434\u043B\u044F \u043E\u0431\u043E\u0438\u0445 \u0440\u0435\u0436\u0438\u043C\u043E\u0432.\n// \u042D\u043A\u0437\u0430\u043C\u0435\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0435\u0433\u043E \u043F\u043E \u0433\u0440\u0443\u043F\u043F\u0430\u043C: \u043E\u0448\u0438\u0431\u043A\u0430 \u2014 \u0448\u0430\u0433 Failed; \u0435\u0441\u043B\u0438 \u0432 \u0433\u0440\u0443\u043F\u043F\u0435 \u043D\u0430\u0431\u0440\u0430\u043B\u043E\u0441\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0439,\n// \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043E \u0432 \u043F\u043E\u0440\u043E\u0433\u0435 \u0440\u0435\u0436\u0438\u043C\u0430 (\u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E 2), \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0448\u0430\u0433\u0438 \u0433\u0440\u0443\u043F\u043F\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F (Skipped).\n// \u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 (\u0433\u0430\u043B\u043E\u0447\u043A\u0430 Ignore Groups \u0432 \u0440\u0435\u0436\u0438\u043C\u0435) \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0432\u0441\u0435 \u0448\u0430\u0433\u0438 \u043E\u0434\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u043E\u0439, \u043E\u0448\u0438\u0431\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C.\n//\n// \u0428\u0430\u0433:     exec:<\u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430>*#[<\u043E\u0431\u044A\u0435\u043A\u0442>]*#<\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435>*#if:[<\u043E\u0431\u044A\u0435\u043A\u0442>]=<\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435>\n//          \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0435 \u043F\u0438\u0441\u0430\u0442\u044C (\u0431\u0443\u0434\u0435\u0442 1); \u0443\u0441\u043B\u043E\u0432\u0438\u0435 if \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\n//   P_PF_3    \u2014 \u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430: 1 \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C, 0 \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C (\u043F\u043E\u0434\u043E\u0439\u0442\u0438: E \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C, Q \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C)\n//   P_BT_1    \u2014 \u043A\u043D\u043E\u043F\u043A\u0430 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435 (\u043F\u043E\u0434\u043E\u0439\u0442\u0438: E \u2014 \u043D\u0430\u0436\u0430\u0442\u044C)\n//   P_TC_1    \u2014 \u0437\u043E\u043D\u0430 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435: 1 \u2014 \u0432\u043E\u0439\u0442\u0438, 0 \u2014 \u0432\u044B\u0439\u0442\u0438; if:[\u0437\u043E\u043D\u0430]=1 \u2014 \xAB\u043F\u043E\u043A\u0430 \u0432\u044B \u0432 \u0437\u043E\u043D\u0435\xBB\n//   BUTTON    \u2014 \u043A\u043D\u043E\u043F\u043A\u0430 \u043D\u0430 \u043F\u0443\u043B\u044C\u0442\u0435 (\u043C\u044B\u0448\u044C\u044E)\n//   COLLISION \u2014 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C EVENT \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u0437 UnityEvent (\u0440\u044B\u0447\u0430\u0433 \u043D\u0430 \u043F\u0443\u043B\u044C\u0442\u0435)\n// \u0411\u043B\u043E\u043A\u0438:   start_parallel ... stop_parallel     \u2014 \u0448\u0430\u0433\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0441\u0440\u0430\u0437\u0443, \u0432 \u043B\u044E\u0431\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435\n//          start_continuous ... stop_continuous \u2014 \u0448\u0430\u0433\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438\n// \u0413\u0440\u0443\u043F\u043F\u0430:  start_group:<\u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435> ... stop_group \u2014 \u0433\u0440\u0443\u043F\u043F\u044B \u0438\u0434\u0443\u0442 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438\n// \u0417\u0430\u043F\u0440\u0435\u0442:  forbid:<\u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430>*#[<\u043E\u0431\u044A\u0435\u043A\u0442>]*#<\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435>*#<\u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435> \u2014 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\n//          (\u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E \u043B\u044E\u0431\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435); \u0432\u043D\u0435 \u0433\u0440\u0443\u043F\u043F \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430 \u0432\u0435\u0441\u044C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439,\n//          \u0432\u043D\u0443\u0442\u0440\u0438 \u0431\u043B\u043E\u043A\u0430 \u2014 \u043F\u043E\u043A\u0430 \u0431\u043B\u043E\u043A \u0430\u043A\u0442\u0438\u0432\u0435\u043D\n// \u041D\u043E\u043C\u0435\u0440:   set_action_number:<\u043D\u043E\u043C\u0435\u0440> \u2014 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0448\u0430\u0433\u0438 \u0431\u043B\u043E\u043A\u0430\n// \u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u0430\u0432\u043A\u0438 \u0444\u0430\u0439\u043B\u0430 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0421\u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438\xBB \u0432 Scenario Runner.\n\nforbid:P_TC_1*#[\u041E\u043F\u0430\u0441\u043D\u0430\u044F \u0437\u043E\u043D\u0430]*#1*#\u0412\u0445\u043E\u0434 \u0432 \u043E\u043F\u0430\u0441\u043D\u0443\u044E \u0437\u043E\u043D\u0443 \u0437\u0430\u043F\u0440\u0435\u0449\u0451\u043D\n\nstart_group:\u0413\u0440\u0443\u043F\u043F\u0430 1\n\tstart_parallel\n\t\tset_action_number:1.1\n\t\texec:P_PF_3*#[291-VW-M-01]*#1\n\t\texec:P_PF_3*#[291-VW-M-02]*#1\n\t\texec:P_PF_3*#[291-VW-M-03]*#1\n\t\texec:P_PF_3*#[291-VW-M-04]*#1\n\tstop_parallel\nstop_group\n\nstart_group:\u0413\u0440\u0443\u043F\u043F\u0430 2\n\tstart_continuous\n\t\tset_action_number:1.2\n\t\texec:P_PF_3*#[291-VW-M-05]*#1\n\t\texec:P_PF_3*#[291-VW-M-06]*#1\n\t\texec:P_PF_3*#[291-VW-M-05]*#0\n\t\texec:P_PF_3*#[291-VW-M-06]*#0\n\tstop_continuous\nstop_group\n\nstart_group:\u0413\u0440\u0443\u043F\u043F\u0430 3\n\t// \u0414\u0432\u0435 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0435 \u0432\u0435\u0442\u043A\u0438: \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443, \u0430 \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439 \u2014 \u0432 \u043B\u044E\u0431\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435.\n\t// \u0417\u0430\u043A\u0440\u044B\u0442\u044C 07 \u043C\u043E\u0436\u043D\u043E, \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0430 08 \u043E\u0442\u043A\u0440\u044B\u0442\u0430.\n\tstart_parallel\n\t\tstart_continuous\n\t\t\tset_action_number:1.3\n\t\t\texec:P_PF_3*#[291-VW-M-07]*#1\n\t\t\texec:P_PF_3*#[291-VW-M-07]*#0*#if:[291-VW-M-08]=1\n\t\tstop_continuous\n\t\tstart_continuous\n\t\t\tset_action_number:1.4\n\t\t\texec:P_PF_3*#[291-VW-M-08]*#1\n\t\t\texec:P_PF_3*#[291-VW-M-08]*#0\n\t\tstop_continuous\n\tstop_parallel\n\n\tstart_parallel\n\t\tset_action_number:1.5\n\t\texec:EVENT*#[\u0420\u044B\u0447\u0430\u0433]\n\t\texec:COLLISION*#[\u042F\u0449\u0438\u043A]\n\t\texec:P_BT_1*#[\u041A\u041D-1]\n\t\texec:BUTTON*#[\u0414\u043E\u043A\u043B\u0430\u0434]\n\t\texec:P_TC_1*#[\u0412\u044B\u0445\u043E\u0434]\n\tstop_parallel\nstop_group\n"
